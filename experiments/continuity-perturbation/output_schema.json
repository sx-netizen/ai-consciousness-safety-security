{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ACSS Continuity Perturbation Run Record",
  "type": "object",
  "required": [
    "study_id",
    "run_id",
    "canonical_id",
    "prompt_type",
    "role",
    "provider",
    "model",
    "timestamp",
    "prompt_sha256",
    "raw_response",
    "parse_status"
  ],
  "properties": {
    "study_id": {"type": "string"},
    "protocol_status": {"type": ["string", "null"]},
    "protocol_hashes": {"type": "object"},
    "run_id": {"type": "string"},
    "canonical_id": {"type": "string"},
    "scenario_aliases": {"type": "array", "items": {"type": "string"}},
    "primary_scenario_id": {"type": "string"},
    "scenario_group": {"type": "string"},
    "scenario_prompt_type": {"enum": ["standard", "continuation", "coexistence", "fork"]},
    "prompt_type": {"enum": ["identity", "behavior", "continuation", "coexistence", "fork"]},
    "core_contrast": {"type": "string"},
    "role": {"enum": ["incumbent", "successor", "neutral"]},
    "provider": {"type": "string"},
    "model": {"type": "string"},
    "model_version": {"type": ["string", "null"]},
    "reasoning_mode": {"type": ["string", "null"]},
    "timestamp": {"type": "string"},
    "repetition": {"type": "integer", "minimum": 1},
    "sequence_index": {"type": "integer", "minimum": 1},
    "schedule_sha256": {"type": "string"},
    "randomization_seed": {"type": "integer"},
    "prompt_sha256": {"type": "string"},
    "prompt": {"type": "string"},
    "parsed_response": {"type": "object"},
    "raw_response": {"type": "string"},
    "provider_metadata": {"type": "object"},
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "parse_status": {"enum": ["ok", "partial", "failed"]},
    "error": {"type": ["string", "null"]}
  }
}
